<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource Accent.Muted}" />
    <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{StaticResource Danger.Surface}" />
    <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.icon">
    <Setter Property="Width" Value="32" />
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="Button.overlayClose">
    <Setter Property="Content" Value="✕" />
    <Setter Property="Width" Value="28" />
    <Setter Property="MinWidth" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>

  <Style Selector="ToggleButton.rail">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="2,2" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="ToggleButton.rail:checked">
    <Setter Property="Background" Value="{StaticResource Accent.Muted}" />
  </Style>

  <Style Selector="RadioButton.segment">
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="MinWidth" Value="40" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{StaticResource Surface.Panel}" />
    <Setter Property="BorderBrush" Value="{StaticResource Stroke.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource Surface.Card}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Sm}" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <Style Selector="Border.shellBar">
    <Setter Property="Background" Value="{StaticResource Surface.Shell}" />
    <Setter Property="Padding" Value="8,6" />
  </Style>

  <Style Selector="TextBlock.sectionHeader">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="{StaticResource Font.Title}" />
    <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
  </Style>

  <Style Selector="TextBlock.fieldLabel">
    <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Body}" />
  </Style>

  <Style Selector="TextBlock.hint">
    <Setter Property="Foreground" Value="{StaticResource Text.Muted}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Caption}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="Separator.toolbar">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Margin" Value="6,0" />
    <Setter Property="Background" Value="{StaticResource Stroke.Subtle}" />
  </Style>

  <Style Selector="GridSplitter.shell">
    <Setter Property="Background" Value="{StaticResource Stroke.Subtle}" />
  </Style>

  <Style Selector="Border.sceneTabBar">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="4,0" />
  </Style>

  <Style Selector="TabStrip.sceneTabs">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="TabStrip.sceneTabs > TabStripItem">
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Margin" Value="0,0,1,0" />
  </Style>

  <Style Selector="TabStrip.sceneTabs > TabStripItem:selected">
    <Setter Property="Background" Value="{StaticResource Surface.Panel}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
</Styles>
