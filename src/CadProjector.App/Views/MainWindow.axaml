<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CadProjector.App.ViewModels"
        xmlns:ctrl="using:CadProjector.App.Controls"
        xmlns:panels="using:CadProjector.App.Views.Panels"
        xmlns:conv="using:CadProjector.App.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="CadProjector.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="2Cut"
        Icon="/Assets/logo.ico"
        WindowState="Maximized"
        MinWidth="1024"
        MinHeight="640"
        Background="{StaticResource Surface.Canvas}">

  <Window.Resources>
    <conv:StringEqualsConverter x:Key="StringEq" />
    <conv:LogStatusBrushConverter x:Key="LogStatusBrush" />
    <conv:BoolToBrushConverter x:Key="LinkBrush"
                               TrueBrush="{StaticResource Danger}"
                               FalseBrush="{StaticResource Accent}" />
  </Window.Resources>

  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <Grid x:Name="RootShell" RowDefinitions="Auto,*,4,0,Auto">
    <!-- 0: AppBar -->
    <Border Grid.Row="0" Classes="shellBar">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Image Source="/Assets/logo.png" Width="28" Height="28"
                 Stretch="Uniform" VerticalAlignment="Center"
                 ToolTip.Tip="{DynamicResource Ui.Brand}" />
          <TextBlock Text="{DynamicResource Ui.Brand}" FontWeight="Bold" FontSize="16"
                     VerticalAlignment="Center" Foreground="{StaticResource Text.Primary}" />
          <Menu VerticalAlignment="Center">
            <MenuItem Header="{DynamicResource Ui.MenuFile}">
              <MenuItem Header="{DynamicResource Ui.NewProject}" Command="{Binding NewProjectCommand}"
                        InputGesture="Ctrl+N" />
              <Separator />
              <MenuItem Header="{DynamicResource Ui.Open}" Command="{Binding OpenFileCommand}"
                        InputGesture="Ctrl+O" />
              <MenuItem Header="{DynamicResource Ui.Load}" Command="{Binding LoadProjectCommand}" />
              <MenuItem Header="{DynamicResource Ui.Save}" Command="{Binding SaveProjectCommand}"
                        InputGesture="Ctrl+S" />
              <Separator />
              <MenuItem Header="{DynamicResource Ui.ExportIld}" Command="{Binding ExportIldCommand}" />
              <Separator />
              <MenuItem Header="{DynamicResource Ui.WorkFolder}" Command="{Binding OpenWorkFolderCommand}" />
              <Separator />
              <MenuItem Header="{DynamicResource Ui.Clear}" Command="{Binding ClearSceneCommand}" />
            </MenuItem>
            <MenuItem Header="{DynamicResource Ui.MenuEdit}">
              <MenuItem Header="{DynamicResource Ui.Undo}" Command="{Binding UndoCommand}"
                        InputGesture="Ctrl+Z" />
              <MenuItem Header="{DynamicResource Ui.Redo}" Command="{Binding RedoCommand}"
                        InputGesture="Ctrl+Y" />
              <Separator />
              <MenuItem Header="{DynamicResource Ui.Group}" Command="{Binding GroupObjectsCommand}" />
              <MenuItem Header="{DynamicResource Ui.Ungroup}" Command="{Binding UngroupObjectCommand}" />
              <Separator />
              <MenuItem Header="{DynamicResource Ui.Hotkeys}" Command="{Binding OpenHotkeysCommand}"
                        InputGesture="F1" />
            </MenuItem>
            <MenuItem Header="{DynamicResource Ui.MenuScenes}">
              <MenuItem Header="{DynamicResource Ui.AddScene}" Command="{Binding AddSceneCommand}" />
              <MenuItem Header="{DynamicResource Ui.RemoveScene}" Command="{Binding RemoveSceneCommand}" />
              <Separator />
              <MenuItem Header="{DynamicResource Ui.Scene}" Command="{Binding OpenScenePanelCommand}" />
              <Separator />
              <MenuItem Header="{Binding LanguageCode, StringFormat={}{0}}"
                        Command="{Binding ToggleLanguageCommand}" />
            </MenuItem>
            <MenuItem Header="{DynamicResource Ui.MenuView}">
              <MenuItem Header="{DynamicResource Ui.Viewport2D}" Command="{Binding SetViewport2DCommand}" />
              <MenuItem Header="{DynamicResource Ui.Viewport3DShort}" Command="{Binding SetViewport3DCommand}" />
              <Separator />
              <MenuItem Header="{DynamicResource Ui.Objects}" Command="{Binding OpenTreeCommand}"
                        InputGesture="F2" />
              <MenuItem Header="{DynamicResource Ui.WorkFolder}" Command="{Binding OpenWorkFolderCommand}" />
              <MenuItem Header="{DynamicResource Ui.Transform}" Command="{Binding OpenTransformCommand}"
                        InputGesture="F4" />
              <MenuItem Header="{DynamicResource Ui.Logs}" Command="{Binding ToggleBottomConsoleCommand}"
                        InputGesture="F12" />
              <Separator />
              <MenuItem Header="{DynamicResource Ui.FitView}" Command="{Binding ResetViewCommand}" />
              <MenuItem Header="{DynamicResource Ui.ResetLayout}" Command="{Binding ResetWorkspaceLayoutCommand}" />
            </MenuItem>
            <MenuItem Header="{DynamicResource Ui.MenuDevices}">
              <MenuItem Header="{DynamicResource Ui.Devices}" Command="{Binding OpenDevicesCommand}" />
              <MenuItem Header="{DynamicResource Ui.Calibrate}" Command="{Binding OpenCalibrateCommand}" />
              <Separator />
              <MenuItem Header="{DynamicResource Ui.Connect}" Command="{Binding ConnectSelectedCommand}" />
              <MenuItem Header="{DynamicResource Ui.VirtualOnly}" Command="{Binding UseVirtualCommand}" />
              <Separator />
              <MenuItem Header="{DynamicResource Ui.Automation}" Command="{Binding OpenAutomationCommand}" />
            </MenuItem>
            <MenuItem Header="{DynamicResource Ui.MenuHelp}">
              <MenuItem Header="{DynamicResource Ui.Hotkeys}" Command="{Binding OpenHotkeysCommand}" />
            </MenuItem>
          </Menu>
          <Button Classes="icon" Content="↶" Command="{Binding UndoCommand}"
                  ToolTip.Tip="{Binding UndoHint}"
                  AutomationProperties.Name="{DynamicResource Ui.Undo}" />
          <Button Classes="icon" Content="↷" Command="{Binding RedoCommand}"
                  ToolTip.Tip="{Binding RedoHint}"
                  AutomationProperties.Name="{DynamicResource Ui.Redo}" />
        </StackPanel>

        <Border Grid.Column="1"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                Margin="12,0" Padding="8,4" CornerRadius="4"
                Background="{StaticResource Surface.Card}"
                Cursor="Hand"
                MaxWidth="520"
                IsVisible="{Binding HasProjectPath}"
                ToolTip.Tip="{Binding ProjectPathToolTip}"
                DoubleTapped="ProjectPath_DoubleTapped"
                AutomationProperties.Name="{DynamicResource Ui.ProjectPath}">
          <TextBlock Text="{Binding ProjectPath}"
                     FontSize="11"
                     Foreground="{StaticResource Accent}"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" />
        </Border>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Border Padding="8,4" CornerRadius="4" Background="{StaticResource Surface.Card}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Ellipse Width="8" Height="8"
                       Fill="{Binding LaserAlert, Converter={StaticResource LinkBrush}}" />
              <TextBlock Text="{Binding DeviceLinkText}" VerticalAlignment="Center" FontSize="12"
                         Foreground="{Binding LaserAlert, Converter={StaticResource LinkBrush}}" />
            </StackPanel>
          </Border>
          <Button Classes="primary" Content="{DynamicResource Ui.Play}" Command="{Binding PlayCommand}" />
          <Button Classes="danger" Content="{DynamicResource Ui.Stop}" Command="{Binding StopCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 1: Work area -->
    <Grid x:Name="WorkAreaGrid" Grid.Row="1"
          ColumnDefinitions="44,300,4,*,4,340">
      <Border Grid.Column="0" Background="{StaticResource Surface.Shell}"
              BorderBrush="{StaticResource Stroke.Subtle}" BorderThickness="0,0,1,0">
        <StackPanel Margin="2,8,2,0" Spacing="2">
          <ToggleButton Classes="rail" Content="▤"
                        IsChecked="{Binding IsTreeOpen}"
                        ToolTip.Tip="{DynamicResource Ui.Objects}"
                        AutomationProperties.Name="{DynamicResource Ui.Objects}" />
          <ToggleButton Classes="rail" Content="▦"
                        IsChecked="{Binding IsSceneOpen}"
                        ToolTip.Tip="{DynamicResource Ui.Scene}"
                        AutomationProperties.Name="{DynamicResource Ui.Scene}" />
          <ToggleButton Classes="rail" Content="📁"
                        IsChecked="{Binding IsWorkFolderOpen}"
                        ToolTip.Tip="{DynamicResource Ui.WorkFolder}"
                        AutomationProperties.Name="{DynamicResource Ui.WorkFolder}" />
        </StackPanel>
      </Border>

      <Border x:Name="LeftDockHost" Grid.Column="1"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              Background="{StaticResource Surface.Panel}"
              BorderBrush="{StaticResource Stroke.Subtle}"
              BorderThickness="0,0,1,0"
              ClipToBounds="True">
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
          <panels:ObjectsPanel IsVisible="{Binding IsTreeOpen}"
                               HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
          <panels:ScenePanel IsVisible="{Binding IsSceneOpen}"
                             HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
          <panels:WorkFolderPanel IsVisible="{Binding IsWorkFolderOpen}"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        </Grid>
      </Border>

      <GridSplitter x:Name="LeftSplitter" Grid.Column="2" Classes="shell" Width="4"
                    ResizeDirection="Columns"
                    HorizontalAlignment="Stretch" />

      <!-- Viewport + scene tabs -->
      <Grid Grid.Column="3" RowDefinitions="*,Auto" Background="{StaticResource Surface.Canvas}">
        <Grid Grid.Row="0">
          <ctrl:SceneCanvas x:Name="SceneView"
                            IsVisible="{Binding !IsViewport3D}"
                            Scene="{Binding SelectedScene}"
                            Project="{Binding Project}"
                            Revision="{Binding CanvasRevision}"
                            FovOverlays="{Binding FovOverlays}"
                            ModuleOverlays="{Binding ModuleOverlays}"
                            MaskEditable="{Binding ShowMaskOverlay}"
                            MeshOwnerLabel="{Binding MeshOwnerLabel}"
                            AlignPick="{Binding MeshAlignPick}"
                            AlignMarkers="{Binding MeshAlignMarkers}" />
          <Grid IsVisible="{Binding IsViewport3D}">
            <ctrl:SceneViewport3D x:Name="View3D"
                                  Scene="{Binding SelectedScene}"
                                  Project="{Binding Project}"
                                  Revision="{Binding CanvasRevision}"
                                  AlignPick="{Binding MeshAlignPick}"
                                  AlignMarkers="{Binding MeshAlignMarkers}"
                                  ViewProjector="{Binding ViewProjector}"
                                  CoverageProjector="{Binding CoverageProjector}"
                                  Rigs="{Binding Projectors}" />
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="12"
                        HorizontalAlignment="Left" VerticalAlignment="Top">
              <ToggleButton Content="{DynamicResource Ui.ViewFromProjector}"
                            IsChecked="{Binding ViewFromProjector}"
                            ToolTip.Tip="{DynamicResource Ui.ViewFromProjectorHint}" />
              <ToggleButton Content="{DynamicResource Ui.ShowCoverage}"
                            IsChecked="{Binding ShowCoverage}"
                            ToolTip.Tip="{DynamicResource Ui.ShowCoverageHint}" />
              <Button Content="{DynamicResource Ui.AimProjector}"
                      Command="{Binding AimProjectorAtTargetCommand}"
                      ToolTip.Tip="{DynamicResource Ui.AimProjectorHint}" />
            </StackPanel>
            <StackPanel Margin="12,0,12,12" Spacing="2"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        IsHitTestVisible="False">
              <TextBlock Text="{Binding CoverageInfo}" Foreground="{StaticResource Accent}" FontSize="11" TextWrapping="Wrap" />
              <TextBlock Text="{DynamicResource Ui.CoverageLegend}"
                         Foreground="{StaticResource Text.Muted}" FontSize="11" TextWrapping="Wrap"
                         IsVisible="{Binding ShowCoverage}" />
              <TextBlock Text="{DynamicResource Ui.Viewport3DHint}"
                         Foreground="{StaticResource Text.Muted}" FontSize="11" />
            </StackPanel>
          </Grid>

          <!-- Canvas HUD: view modes + tools -->
          <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                  Margin="8" Padding="4" CornerRadius="4"
                  Background="{StaticResource Surface.Shell}"
                  BorderBrush="{StaticResource Stroke.Subtle}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <RadioButton Classes="segment" Content="{DynamicResource Ui.Viewport2D}"
                           GroupName="Viewport"
                           IsChecked="{Binding !IsViewport3D}"
                           Command="{Binding SetViewport2DCommand}" />
              <RadioButton Classes="segment" Content="{DynamicResource Ui.Viewport3DShort}"
                           GroupName="Viewport"
                           IsChecked="{Binding IsViewport3D}"
                           Command="{Binding SetViewport3DCommand}"
                           ToolTip.Tip="{DynamicResource Ui.Viewport3D}" />
              <ToggleButton Content="{DynamicResource Ui.Mask}"
                            IsChecked="{Binding ShowMaskOverlay}"
                            ToolTip.Tip="{DynamicResource Ui.ShowMask}" />
              <ToggleButton Content="{DynamicResource Ui.Mesh}"
                            IsChecked="{Binding ShowMeshOverlay}"
                            ToolTip.Tip="{DynamicResource Ui.ShowMesh}" />
              <Button Classes="icon" Content="⤢" Command="{Binding ResetViewCommand}"
                      ToolTip.Tip="{DynamicResource Ui.FitView}"
                      AutomationProperties.Name="{DynamicResource Ui.FitView}" />
            </StackPanel>
          </Border>
        </Grid>

        <Border Grid.Row="1" Classes="sceneTabBar"
                Background="{StaticResource Surface.Shell}"
                BorderBrush="{StaticResource Stroke.Subtle}"
                BorderThickness="0,1,0,0">
          <TabStrip Classes="sceneTabs"
                    ItemsSource="{Binding Scenes}"
                    SelectedItem="{Binding SelectedScene}">
            <TabStrip.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name}" FontSize="11" />
              </DataTemplate>
            </TabStrip.ItemTemplate>
          </TabStrip>
        </Border>
      </Grid>

      <GridSplitter x:Name="RightSplitter" Grid.Column="4" Classes="shell" Width="4"
                    ResizeDirection="Columns"
                    HorizontalAlignment="Stretch" />

      <!-- Right inspector -->
      <Border x:Name="RightDockHost" Grid.Column="5"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              Background="{StaticResource Surface.Panel}"
              BorderBrush="{StaticResource Stroke.Subtle}"
              BorderThickness="1,0,0,0"
              ClipToBounds="True">
        <DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
          <DockPanel DockPanel.Dock="Top" Margin="8,8,8,0">
            <Button Classes="overlayClose" DockPanel.Dock="Right"
                    Command="{Binding CloseOverlayCommand}" CommandParameter="Right"
                    ToolTip.Tip="{DynamicResource Ui.Close}" />
            <TextBlock Text="{DynamicResource Ui.Inspector}" Classes="sectionHeader"
                       VerticalAlignment="Center" />
          </DockPanel>
          <TabControl SelectedIndex="{Binding Workspace.RightTabIndex}">
            <TabItem Header="{DynamicResource Ui.Transform}">
              <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                  <TextBlock Margin="12" Classes="hint" Text="{DynamicResource Ui.TransformNoTarget}"
                             IsVisible="{Binding HasTransformEmpty}" />
                  <panels:TransformPanel IsVisible="{Binding !HasTransformEmpty}"
                                         HorizontalAlignment="Stretch" />
                </StackPanel>
              </ScrollViewer>
            </TabItem>
            <TabItem Header="{DynamicResource Ui.Devices}">
              <panels:DevicePanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            </TabItem>
            <TabItem Header="{DynamicResource Ui.StlAlign}" IsEnabled="{Binding HasMeshTarget}">
              <Grid>
                <StackPanel Margin="12" Spacing="8" IsVisible="{Binding !HasMeshTarget}">
                  <TextBlock Classes="hint" Text="{DynamicResource Ui.StlNone}" />
                  <Button Content="{DynamicResource Ui.StlLoad}" Command="{Binding LoadStlTargetCommand}" />
                </StackPanel>
                <panels:StlAlignPanel IsVisible="{Binding HasMeshTarget}"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
              </Grid>
            </TabItem>
          </TabControl>
        </DockPanel>
      </Border>
    </Grid>

    <!-- 2: Bottom splitter -->
    <GridSplitter x:Name="BottomSplitter" Grid.Row="2" Classes="shell" Height="4"
                  ResizeDirection="Rows" HorizontalAlignment="Stretch" />

    <!-- 3: Bottom console -->
    <Border x:Name="BottomDockHost" Grid.Row="3"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            Background="{StaticResource Surface.Panel}"
            BorderBrush="{StaticResource Stroke.Subtle}"
            BorderThickness="0,1,0,0"
            ClipToBounds="True">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="8,4,8,0">
          <Button Classes="overlayClose" DockPanel.Dock="Right"
                  Command="{Binding CloseOverlayCommand}" CommandParameter="Bottom"
                  ToolTip.Tip="{DynamicResource Ui.Close}" />
          <TextBlock Text="{DynamicResource Ui.Console}" Classes="sectionHeader"
                     VerticalAlignment="Center" />
        </DockPanel>
        <panels:ConsolePanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
      </DockPanel>
    </Border>

    <!-- 4: Status bar -->
    <Border Grid.Row="4" Classes="shellBar" Padding="10,4"
            BorderBrush="{StaticResource Stroke.Subtle}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                   Foreground="{StaticResource Text.Secondary}" FontSize="12"
                   TextTrimming="CharacterEllipsis" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="12,0"
                    VerticalAlignment="Center">
          <TextBlock Text="{Binding DeviceLinkText}" FontSize="11"
                     Foreground="{Binding LaserAlert, Converter={StaticResource LinkBrush}}" />
          <TextBlock FontSize="11" Foreground="{StaticResource Text.Muted}">
            <TextBlock.Text>
              <MultiBinding StringFormat="{}{0:0.#}×{1:0.#} mm">
                <Binding Path="SceneWidthMm" />
                <Binding Path="SceneHeightMm" />
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                    IsVisible="{Binding Progress.HasActive}" VerticalAlignment="Center">
          <TextBlock Text="{Binding Progress.LastProgress.Name}" Foreground="{StaticResource Text.Secondary}"
                     FontSize="11" MaxWidth="220" TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" />
          <ProgressBar Width="120" Height="8" Minimum="0" Maximum="1"
                       Value="{Binding Progress.LastProgress.Fraction}"
                       IsIndeterminate="{Binding Progress.LastProgress.IsIndeterminate}" />
          <Button Content="{DynamicResource Ui.CancelBusy}" Classes="danger"
                  Command="{Binding Progress.LastProgress.CancelationCommand}"
                  Padding="8,2" MinWidth="72" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
