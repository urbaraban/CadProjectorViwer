<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="using:CadProjector.App.Controls"
        xmlns:vm="using:CadProjector.App.ViewModels"
        x:Class="CadProjector.App.Views.ProjectorPreviewWindow"
        x:DataType="vm:ProjectorPreviewViewModel"
        Title="{Binding Title}"
        Width="480"
        Height="560"
        MinWidth="300"
        MinHeight="360"
        Background="{StaticResource Surface.Canvas}"
        WindowStartupLocation="CenterOwner">

  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
      <TextBlock Text="{Binding Stats}" Classes="hint" />
      <DockPanel>
        <TextBlock Text="{DynamicResource Ui.StrokeThickness}" Classes="fieldLabel"
                   VerticalAlignment="Center" Margin="0,0,8,0" />
        <Slider Minimum="0.5" Maximum="6" Value="{Binding StrokeThickness}" />
      </DockPanel>
      <StackPanel Orientation="Horizontal" Spacing="12">
        <CheckBox Content="{DynamicResource Ui.ShowBlanked}" IsChecked="{Binding ShowBlanked}"
                  Foreground="{StaticResource Text.Secondary}" />
        <CheckBox Content="{DynamicResource Ui.ShowPoints}" IsChecked="{Binding ShowPoints}"
                  Foreground="{StaticResource Text.Secondary}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="{DynamicResource Ui.RefreshPreview}" Command="{Binding RefreshCommand}" />
        <Button Content="{DynamicResource Ui.OpenInIldaViewer}" Command="{Binding OpenInIldaViewerCommand}" />
      </StackPanel>
    </StackPanel>
    <Border Background="Black" BorderBrush="{StaticResource Stroke.Subtle}" BorderThickness="1" CornerRadius="2">
      <Viewbox Stretch="Uniform">
        <ctrl:IldaFrameCanvas Width="400" Height="400"
                              Frame="{Binding Frame}"
                              StrokeThickness="{Binding StrokeThickness}"
                              ShowBlanked="{Binding ShowBlanked}"
                              ShowPoints="{Binding ShowPoints}" />
      </Viewbox>
    </Border>
  </DockPanel>
</Window>
