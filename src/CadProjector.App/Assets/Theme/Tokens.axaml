<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Surfaces: higher layer = lighter -->
  <SolidColorBrush x:Key="Surface.Canvas" Color="#12151A" />
  <SolidColorBrush x:Key="Surface.Shell" Color="#1A1E24" />
  <SolidColorBrush x:Key="Surface.Panel" Color="#22272F" />
  <SolidColorBrush x:Key="Surface.Card" Color="#2A303A" />
  <SolidColorBrush x:Key="Surface.Hover" Color="#333A46" />
  <SolidColorBrush x:Key="Stroke.Subtle" Color="#38404C" />
  <SolidColorBrush x:Key="Stroke.Strong" Color="#4C5666" />

  <!-- Text: AA on Surface.Panel -->
  <SolidColorBrush x:Key="Text.Primary" Color="#F2F5F9" />
  <SolidColorBrush x:Key="Text.Secondary" Color="#B4BECD" />
  <SolidColorBrush x:Key="Text.Muted" Color="#8B95A5" />

  <!-- Semantic -->
  <SolidColorBrush x:Key="Accent" Color="#4EA3F5" />
  <SolidColorBrush x:Key="Accent.Muted" Color="#2A5C8C" />
  <SolidColorBrush x:Key="Success" Color="#4CC38A" />
  <SolidColorBrush x:Key="Warning" Color="#E5A44B" />
  <SolidColorBrush x:Key="Danger" Color="#E5484D" />
  <SolidColorBrush x:Key="Danger.Surface" Color="#3B1A1C" />

  <!-- Metrics -->
  <x:Double x:Key="Space.Xs">4</x:Double>
  <x:Double x:Key="Space.Sm">8</x:Double>
  <x:Double x:Key="Space.Md">12</x:Double>
  <x:Double x:Key="Space.Lg">16</x:Double>
  <CornerRadius x:Key="Radius.Sm">4</CornerRadius>
  <CornerRadius x:Key="Radius.Md">6</CornerRadius>
  <x:Double x:Key="Font.Caption">11</x:Double>
  <x:Double x:Key="Font.Body">12</x:Double>
  <x:Double x:Key="Font.Title">14</x:Double>
  <x:Double x:Key="Row.Height">28</x:Double>
</ResourceDictionary>
