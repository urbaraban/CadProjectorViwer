<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CadProjector.App.ViewModels"
             x:Class="CadProjector.App.Views.Panels.ObjectsPanel"
             x:DataType="vm:MainViewModel">

  <Border Classes="panel" Padding="12" CornerRadius="4"
          HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
        <DockPanel>
          <Button Classes="overlayClose" DockPanel.Dock="Right"
                  Command="{Binding CloseOverlayCommand}" CommandParameter="Tree"
                  ToolTip.Tip="{DynamicResource Ui.Close}" />
          <TextBlock Text="{DynamicResource Ui.ObjectsTitle}" Classes="sectionHeader"
                     VerticalAlignment="Center" />
        </DockPanel>
        <Button Content="{DynamicResource Ui.ToggleLayer}" Command="{Binding ToggleSelectedLayerVisibilityCommand}" />
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Content="{DynamicResource Ui.Group}" Command="{Binding GroupObjectsCommand}" />
          <Button Content="{DynamicResource Ui.Ungroup}" Command="{Binding UngroupObjectCommand}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Content="{DynamicResource Ui.HotkeySelectBack}" Command="{Binding SelectBackCommand}" />
          <Button Content="{DynamicResource Ui.HotkeySelectNext}" Command="{Binding SelectNextCommand}" />
        </StackPanel>
        <TextBlock Text="{DynamicResource Ui.ObjectName}" Classes="fieldLabel" />
        <TextBox Text="{Binding ObjectName}" />
        <CheckBox Content="{DynamicResource Ui.Lock}" IsChecked="{Binding ObjectLocked}"
                  Foreground="{StaticResource Text.Secondary}" />
      </StackPanel>
      <TreeView x:Name="ObjectTree"
                ItemsSource="{Binding ObjectItems}"
                SelectionMode="Multiple"
                Background="Transparent">
        <TreeView.ItemTemplate>
          <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="vm:ObjectListItem">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <CheckBox IsChecked="{Binding IsVisible}" ToolTip.Tip="{DynamicResource Ui.Visible}" />
              <CheckBox IsChecked="{Binding IsLocked}" ToolTip.Tip="{DynamicResource Ui.Lock}" />
              <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource Text.Secondary}"
                         VerticalAlignment="Center" />
            </StackPanel>
          </TreeDataTemplate>
        </TreeView.ItemTemplate>
        <TreeView.Styles>
          <Style Selector="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, DataType={x:Type vm:ObjectListItem}}" />
          </Style>
        </TreeView.Styles>
      </TreeView>
    </DockPanel>
  </Border>
</UserControl>
